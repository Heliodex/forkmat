}

// Comments between the tokens of a list break it; a comment inside an
// element does not.
func comments(a, b int) (int, int) {
	x := f( // lead
		a,
		b,
	)
	y := g(
		"a", // first
		"b",
	) // second
	z := []int{
		1, // one
		2,
	}
	_, _ = y, z

	return a, // c
		b
}

// A body holding only a comment is printed over several lines.
func commentOnly() {
	// nothing here
}

