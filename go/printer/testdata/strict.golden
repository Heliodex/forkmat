)

// third has a comment above it, so it starts a new group.
var third = 3

func vars() {
	x := 1
	y := 2
	// a comment keeps these apart
	var z = 3

	w := 4
	_, _, _, _ = x, y, z, w
}

// var declarations with values and no type become := assignments inside a
// function; the others stay declarations.
func shortVars() (int, error) {
	x := 1
	y, z := 2, shortVars2()

	var (
		_ = y
		w int = 3
	)

	a := 4

	var b int

	c := 5
	q, _ := g()
	_, _, _, _, _ = x, z, w, a, c

	return q, nil
}

var packageVar = 1

// Runs of calls, assignments, and const and var declarations are set off from
// each other; a send statement sets nothing off.
func kinds(ch chan int) {
	fmt.Println("a")
	fmt.Println("b")

	const (
		k = 1
		m = 2
	)

	x := k
	x++

	var y int

	y = x
	ch <- y
	ch <- m
	fmt.Println(y)
}

// A := declaration of a zero value is written as a var declaration with its
// type. Other values, and := with several names, are left alone.
func zeros() {
	var (
		x int
		y float64
		z complex128
		s string
		b bool
		a int32
		c float64
	)

	m := 1
	n := string(0)

	var r uint8 // trailing
	p, q := 0, 0
	_, _, _, _, _, _, _, _, _, _ = x, y, z, s, b, a, c, m, n, r
	_, _ = p, q
}

// Consecutive var specs of one type and no values share one line. A spec
// with a value, or with a comment, is kept apart.
var (
	vx, vy int32
	vz = 1
	vw int32
)

func mergeVars() {
	var (
		pc, top int32
		n int
	)

	var m int // kept
	var k int

	_, _, _, _, _ = pc, top, n, m, k
}

type (
	// Sequential type declarations, at package level or in a block, share one
	// type (...) declaration. A var between them keeps them apart.

	tA int

	tB struct {
		X int
	}
)

var tv int

type tC []string

func localTypes() {
	type (
		lA int
		lB = int
	)
	_ = lA(lB(1))
}

var _ = errgroup.Group{}

// An if statement whose condition uses a name declared just before it follows
// that declaration directly. A condition that uses no such name is set off.
func ifUse(a int) error {
	n, err := g()
	if err != nil {
		return err
	}

	if m := a * 2; m > 3 {
		return nil
	}

	k := a

	if a > 0 {
		k++
	}

	_, _ = n, k

	return nil
}

type (
	// Compiler allows programs to be compiled and deserialised with a cache and given optimisation level.
	Compiler struct {
		Cache map[[32]byte]internal.Deserpath
		O uint8
	}

	// Luau types

	// Val represents any possible Luau value. Luau type `any`
	Val = internal.Val

	// Function represents a native or wrapped Luau function. Luau type `function`
	Function struct {
		// Run is the native body of the function. Its coroutine argument is used to run the function in a coroutine.
		Run *func(*Coroutine, ...Val) ([]Val, error)
		Name string
		Co *Coroutine // if in a different coroutine
	}

	// Buffer represents a Luau byte buffer. Luau type`buffer`
	// As buffers are compared by reference, this type must always be used as a pointer.
	Buffer []byte

	// Vector represents a 3-wide or 4-wide vector value. Luau type `vector`
	Vector [4]float32

	// Env represents a global Luau environment.
	Env map[string]Val

	// Val represents any possible VM stack/register value.
	Val any

	// VM internals types

	OpInfo struct {
		Mode, KMode uint8
		HasAux bool
	}

	Inst struct {
		K Val
		// K0, K1, K2 for imports (up to 3 lay.ers.deep)
		K0, K1, K2 string
		A, D int32
	}

	// simpler compilation, deserialisation, and loading API

	Deserialised struct {
		MainProto *Proto
	}

	Deserpath struct {
		Deserialised
		Dbgpath string
	}

	// Coroutine types

	// Status represents the status of a coroutine.
	Status uint8
)

var x = 1

const (
	// Single constants group together, except those whose values use iota: iota
	// counts the specs of a group.

	cA = 1
	cB = 2
)

const cC = iota
const cD = iota

func constGroups() {
	const kA = "a"
	const kB = iota
	const kC = "c"

	_, _, _ = kA, kB, kC
}

// Adjacent var groups join into one, as single var declarations do. Const
// groups do not: iota counts the specs of each group.

var (
	_ tIface = tImpl{}
	_ tIface = tOther{}
	_ tOther2 = tImpl{}
	_ tOther2 = tOther{}
)

const (
	gA = iota
	gB
)

const (
	gC = iota
)

const (
	// Constant groups join when no value depends on its place in the group.

	cgA = 1
	cgB = 2

	// Expression precedence levels.
	cgC = 0
	cgD = 9
	cgE = 8
)

// Map literals with string or number keys are sorted by key. A literal with a call
// in a value, or with keys of mixed kinds, keeps its order.
var mapWords = map[string]int{"apple": 1, "pear": 3}

var (
	mapNums = map[int]string{-2: "minus two", 3: "three", 10: "ten"}
	mapCall = map[string]int{"b": mapF(), "a": 1}
)

func mapF() int {
	return 0
}
