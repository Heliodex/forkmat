}

type Commented interface {
	// M is documented.
	M()
}

// Parentheses are dropped where precedence already groups the expression.
func parens(a, b, c int, p *int, ch chan int) int {
	x := (a + b) * c
	y := a*b + c
	z := a
	w := -a
	v := !(a == b)
	u := *p
	t := *p + *p
	s := a + (b + c)
	r := a + b + c
	q := (<-ch)
	f := (func() int {
		return a
	})()
	e := (struct{}{})

	if a == b {
		return x
	}

	_, _, _, _, _, _, _, _, _ = y, z, w, v, u, t, s, r, e

	return f + q
}

func goDefer(mu *mutex) {
	mu.Lock()

	defer mu.Unlock()
	go run()
	defer close()
	go run2()

	x := 1
	_ = x

	defer cleanup()
	go run3()
}

// Consecutive fields of the same type share one type.
type Point struct {
	x, y, z, w int
	name string
	tagged int `json:"t"`
	other,
	left, // comment
	right int
	p, q *int
}

func merged(a, b int, c string, d, e int) (x, y int) {
	return a, b
}

// Blank lines at the start and end of a block are removed; comments at either
// end sit next to the brace.
func edges() {
	// start
	x := 1
	_ = x
	// end
}

func edges2() {
	x := 1
	// end
}

