// The source's breaks inside expressions, lists and selectors are ignored.
func foo() {
    foo :=
        "bar"
    x := []int{
        1, 2, 3}
    y := []int{1,
        2}
    z := 1 +
        2
    fmt.Println(
        "a",
        "b",
    )
    w := os.
        Args
    _, _, _, _ = foo, x, y, z
}

// Blank lines: block statements and returns get one on either side; calls do not.
func blanks(a, b int) int {
    fmt.Println(a)
    if a > b {
        a = b
    }
    fmt.Println(b)
    for i := 0; i < 3; i++ {
        b += i
    }



    var (
        c = 1
        d = 2
    )
    var e = 3
    e++
    return a + b + c + d + e
}

func blankAfterGroup() {
    var (
        p = 1
    )
    if p > 0 {
    }
    q := p
    switch q {
    case 1:
        fmt.Println(q)
        q++
    default:
    }
    select {
    }
    {
        q--
    }
}

