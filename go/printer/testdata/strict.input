func vars() {
	var x = 1
	var y = 2
	// a comment keeps these apart
	var z = 3
	var w = 4
	_, _, _, _ = x, y, z, w
}

// var declarations with values and no type become := assignments inside a
// function; the others stay declarations.
func shortVars() (int, error) {
    var x = 1
    var y, z = 2, shortVars2()
    var _ = y
    var w int = 3
    var (
        a = 4
        b int
        c = 5
    )
    var q, _ = g()
    _, _, _, _, _ = x, z, w, a, c
    return q, nil
}

var packageVar = 1

// Runs of calls, assignments, and const and var declarations are set off from
// each other; a send statement sets nothing off.
func kinds(ch chan int) {
    fmt.Println("a")
    fmt.Println("b")
    const k = 1
    const m = 2
    x := k
    x++
    var y int
    y = x
    ch <- y
    ch <- m
    fmt.Println(y)
}

// A := declaration of a zero value is written as a var declaration with its
// type. Other values, and := with several names, are left alone.
func zeros() {
    x := 0
    y := 0.
    z := 0i
    s := ""
    b := false
    a := int32(0)
    c := float64(0.0)
    m := 1
    n := string(0)
    r := uint8(0) // trailing
    p, q := 0, 0
    _, _, _, _, _, _, _, _, _, _ = x, y, z, s, b, a, c, m, n, r
    _, _ = p, q
}

// Consecutive var specs of one type and no values share one line. A spec
// with a value, or with a comment, is kept apart.
var (
    vx int32
    vy int32
    vz = 1
    vw int32
)

func mergeVars() {
    var pc int32
    var top int32
    var n int
    var m int // kept
    var k int
    _, _, _, _, _ = pc, top, n, m, k
}

// Sequential type declarations, at package level or in a block, share one
// type (...) declaration. A var between them keeps them apart.

type tA int
type tB struct{ X int }
var tv int
type tC []string

func localTypes() {
    type lA int
    type lB = int
    _ = lA(lB(1))
}

var _ = errgroup.Group{}

// An if statement whose condition uses a name declared just before it follows
// that declaration directly. A condition that uses no such name is set off.
func ifUse(a int) error {
    n, err := g()
    if err != nil {
        return err
    }
    var m = a * 2
    if m > 3 {
        return nil
    }
    k := a
    if a > 0 {
        k++
    }
    _, _ = n, k
    return nil
}
